# Copy to .env and fill in. .env is gitignored — never commit real keys.

# "cloud" for the real path, "mock" for the offline demo safety net.
# If left unset, the app picks cloud when the two COGNEE_ vars below are set,
# and mock otherwise. A missing key is therefore never fatal.
PROVIDER=cloud

# --- Cognee Cloud tenant instance ----------------------------------------
# The tenant instance owns the LLM, the embeddings, the vector store and the
# graph. That is why ephemeral Render task runs need nothing but a URL and a
# key: all the state lives outside the container.
#
# Discover yours from a management API key:
#   curl -H "X-Api-Key: $KEY" https://api.aws.cognee.ai/api/tenants/current
#   curl -H "X-Api-Key: $KEY" https://api.aws.cognee.ai/api/tenants/current/service-url
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
COGNEE_DATASET=company_brain
COGNEE_TIMEOUT=600

# --- local server ---------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- Render (deploy only) -------------------------------------------------
RENDER_API_KEY=
RENDER_USE_LOCAL_DEV=true

# --- Optional: self-hosted Cognee instead of cloud ------------------------
# Only needed if you run Cognee locally. Requires a model-provider key
# (Google AI Studio or Groq are free) plus a graph store that outlives the
# container. A file-based backend such as "ladybug" does NOT survive a Render
# task run, which is the entire reason the cloud path exists.
# LLM_API_KEY=
# LLM_PROVIDER=gemini
# GRAPH_DATABASE_PROVIDER=neo4j
# GRAPH_DATABASE_URL=neo4j+s://<instance-id>.databases.neo4j.io
# GRAPH_DATABASE_USERNAME=neo4j
# GRAPH_DATABASE_PASSWORD=
# ENABLE_BACKEND_ACCESS_CONTROL=false
# CACHING=false
# TELEMETRY_DISABLED=true
