# Template for the local OSS Cognee container (BUILD_PLAN.md M0.2 / M1.1).
#   cp .env.oss.example .env.oss      # then fill in; .env.oss is gitignored
#
# ============================================================================
# SWAPPABLE LLM REGISTRY — one ACTIVE block in .env.oss, others commented.
# Cognee routes all model calls through LiteLLM, so every provider below is a
# block swap in .env.oss — no code changes, container restart only.
# Human-confirmed provider list 2026-09-25: OpenAI, Azure, OpenRouter, Groq,
# Cerebras, Anthropic, AWS Bedrock, DeepSeek, Z.AI (+ keyless Ollama).
# ============================================================================
#
# --- DORMANT: keyless local (Ollama on the host, fastembed in-container) ----
# Removed during cleanup 2026-09-25 (models deleted, ~6GB reclaimed; service
# stopped). Re-enable:  brew services start ollama && ollama pull llama3.1:8b
# NOTE: 3B-class models FAIL Cognee's strict structured-output schema
# (measured: llama3.2:3b -> SummarizedContent ValidationError after LiteLLM
# retries) — use an 8B-class model or better.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_ENDPOINT=http://host.docker.internal:11434
# Cognee's LLMConfig requires ALL of model/endpoint/key whenever any is set —
# even for Ollama. Any non-empty dummy satisfies it; it is never sent anywhere.
LLM_API_KEY=ollama-local
# EMBEDDING: fastembed runs IN-PROCESS in the container (no service, no key).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
#
# --- A) Cerebras (default hosted pick: ~1M tok/day free, 5 RPM) -------------
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=
# LLM_ENDPOINT=https://api.cerebras.ai/v1
# LLM_RATE_LIMIT_REQUESTS=5
#
# --- B) Groq (30 RPM free tier) ---------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=
# LLM_ENDPOINT=https://api.groq.com/openai/v1
# LLM_RATE_LIMIT_REQUESTS=30
#
# --- C) OpenRouter (one key, every model; :free variants exist) -------------
# LLM_PROVIDER=custom
# LLM_MODEL=openrouter/deepseek/deepseek-r1
# LLM_API_KEY=
# LLM_ENDPOINT=https://openrouter.ai/api/v1
#
# --- D) OpenAI ---------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=
# LLM_ENDPOINT=            # leave empty: LiteLLM routes openai/ natively
#
# --- E) Azure OpenAI (native, no proxy; needs the API version line) ---------
# LLM_PROVIDER=openai
# LLM_MODEL=azure/gpt-4o-mini
# LLM_API_KEY=
# LLM_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<model>
# LLM_API_VERSION=2024-12-01-preview
#
# --- F) Anthropic (native LiteLLM prefix; no endpoint line) ------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-sonnet-4-20250514
# LLM_API_KEY=
#
# --- G) AWS Bedrock — two auth paths -----------------------------------------
# (a) Long-term Bedrock API key (verified 2026-09-25: auth + routing OK;
#     blocked only by the account's DAILY TOKEN BUDGET — "Too many tokens
#     per day" on the first call, then "Operation not allowed" for the rest
#     of the day on EVERY model and both API paths). Human's model choice:
#     gpt-oss-120b. LiteLLM sends the key as `Authorization: Bearer`; no
#     SigV4, no access/secret pair. Pair with keyless fastembed embeddings.
# AWS_BEARER_TOKEN_BEDROCK=<long-term api key>
# AWS_REGION=us-east-1
# LLM_PROVIDER=bedrock
# LLM_MODEL=bedrock/openai.gpt-oss-120b-1:0
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384
#
# (b) Standard AWS credentials (SigV4):
# export AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_REGION=us-east-1
# LLM_PROVIDER=bedrock
# LLM_MODEL=bedrock/us.anthropic.claude-sonnet-4-5-v2:0
#
# --- H) DeepSeek (OpenAI-compatible) ------------------------------------------
# LLM_PROVIDER=custom
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=
# LLM_ENDPOINT=https://api.deepseek.com/v1
#
# --- I) Z.AI / Zhipu GLM (OpenAI-compatible) ----------------------------------
# LLM_PROVIDER=custom
# LLM_MODEL=zai/glm-4.6
# LLM_API_KEY=
# LLM_ENDPOINT=https://api.z.ai/api/paas/v4
#
# ============================================================================
# GRAPH BACKEND — 28 Sep 2026: postgres_graph_shared is the LIVE default.
# The embedded default shares ONE graph across all datasets (no per-brain
# isolation — measured: 295/295 identical nodes). postgres_graph_shared
# isolates per dataset + survives container restarts (measured M2.2).
# Requires the postgres service in compose.oss.yml.
# GRAPH_DATABASE_PROVIDER=postgres_demo
# GRAPH_DATASET_DATABASE_HANDLER=postgres_graph_shared
# GRAPH_DATABASE_HOST=postgres
# GRAPH_DATABASE_PORT=5432
# GRAPH_DATABASE_USERNAME=kestrel
# GRAPH_DATABASE_PASSWORD=kestrel
# GRAPH_DATABASE_NAME=kestrel
#
# ============================================================================
# EMBEDDINGS — alternatives to the active fastembed block above.
# WARNING: dimensions are baked into the vector store at first ingest.
# Changing the embedding model AFTER ingesting requires a full re-ingest.
#
# Gemini (doc default; generous free tier, 768 dims):
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini/gemini-embedding-001
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_API_KEY=
#
# OpenAI (1536 dims):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=

# --- auth (M0.2): BOTH false to run unauthenticated locally; one is not enough
ENABLE_BACKEND_ACCESS_CONTROL=false
REQUIRE_AUTHENTICATION=false

# JWT secrets became random-per-process in v1.6.0: without a fixed value every
# container restart invalidates all sessions. Local-only placeholder is fine.
FASTAPI_USERS_JWT_SECRET=change-me-locally
