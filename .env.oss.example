# Template for the local OSS Cognee container (BUILD_PLAN.md M0.2).
#   cp .env.oss.example .env.oss      # then fill in; .env.oss is gitignored
#
# Auth is ON by default in Cognee v1.6.1 — BOTH flags must be false to run
# unauthenticated locally; one alone is not enough.
ENABLE_BACKEND_ACCESS_CONTROL=false
REQUIRE_AUTHENTICATION=false

# JWT secrets became random-per-process in v1.6.0: without a fixed value every
# container restart invalidates all sessions. A local-only placeholder is fine.
FASTAPI_USERS_JWT_SECRET=change-me-locally

# --- LLM (M1.1; pick ONE block, uncomment, fill key) -------------------------
# The container boots without these, but ingest/recall need a real key.
# Ingestion runs on OUR free-tier key; rate-limit it to the tier's RPM.
# All five providers below route via LiteLLM (OSS_STACK_AND_COMPETITORS.md
# §1.3); only the key for the chosen block goes into gitignored `.env.oss`.
#
# A. Cerebras free tier (~1M tok/day, 5 RPM):
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=
# LLM_ENDPOINT=https://api.cerebras.ai/v1
# LLM_RATE_LIMIT_REQUESTS=5
#
# B. Groq free tier (30 RPM, OpenAI-compatible; exact model prefix verified
#    on first run — docs confirm gpt-oss-120b served, OSS_STACK line 104):
# LLM_PROVIDER=custom
# LLM_MODEL=groq/gpt-oss-120b
# LLM_API_KEY=
# LLM_ENDPOINT=https://api.groq.com/openai/v1
# LLM_RATE_LIMIT_REQUESTS=5
#
# C. OpenRouter (documented natively; :free models 20 RPM / 50 req/day):
# LLM_PROVIDER=custom
# LLM_MODEL=openrouter/deepseek/deepseek-r1
# LLM_API_KEY=
# LLM_ENDPOINT=https://openrouter.ai/api/v1
# LLM_RATE_LIMIT_REQUESTS=5
#
# D. Azure OpenAI native (no proxy; needs resource + deployment + version):
# LLM_PROVIDER=openai
# LLM_MODEL=azure/gpt-4o-mini
# LLM_API_KEY=
# LLM_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<model>
# LLM_API_VERSION=2024-12-01-preview
#
# E. Anthropic (Cognee provider list; exact model string verified on first run):
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-sonnet-4-20250514
# LLM_API_KEY=
#
# F. Plain OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
#
# --- Embeddings (M1.1 decision: Gemini, per OSS_STACK doc default) ------------
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini/gemini-embedding-001
# EMBEDDING_DIMENSIONS=768           # MUST match the model exactly
# EMBEDDING_API_KEY=
# (fully-local alternative: fastembed / fastembed / 384, no key)
