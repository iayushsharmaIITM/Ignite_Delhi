{"openapi":"3.1.0","info":{"title":"Kestrel Company Brain","version":"0.1.0"},"paths":{"/health":{"get":{"summary":"Health","description":"Always have this. A health endpoint means the demo never looks dead.","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/config":{"get":{"summary":"Config","operationId":"config_api_config_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/chats":{"post":{"summary":"Chats Upsert","operationId":"chats_upsert_api_chats_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"get":{"summary":"Chats List","operationId":"chats_list_api_chats_get","parameters":[{"name":"brain","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Brain"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/chats/{chat_id}":{"get":{"summary":"Chats Get","operationId":"chats_get_api_chats__chat_id__get","parameters":[{"name":"chat_id","in":"path","required":true,"schema":{"type":"string","title":"Chat Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Chats Delete","operationId":"chats_delete_api_chats__chat_id__delete","parameters":[{"name":"chat_id","in":"path","required":true,"schema":{"type":"string","title":"Chat Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/usage":{"get":{"summary":"Usage","operationId":"usage_api_usage_get","parameters":[{"name":"days","in":"query","required":false,"schema":{"type":"integer","default":30,"title":"Days"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/summarize":{"post":{"summary":"Summarize","description":"Rolling-history summarization (P2): older turns compressed into a\nstable summary so multi-turn context stays bounded and cache-friendly.","operationId":"summarize_api_summarize_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/extract":{"post":{"summary":"Extract Attachment","description":"Extract text from ONE chat attachment so the CURRENT answer can use it.\n\nThe ask path feeds text-like files client-side, but PDFs and DOCX keep\ntheir text in binary — pypdf/python-docx extraction has to happen here.\nThis returns the text and touches nothing else: brain ingest remains the\nseparate, explicit upload that makes the file answerable in FUTURE asks.","operationId":"extract_attachment_api_extract_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/actions/draft":{"post":{"summary":"Actions Draft","description":"P6: turn an answered question into a DRAFT email or Slack message.\n\nThe agent only drafts — nothing here sends. Pydantic AI gives typed\noutputs (to/subject/body or channel/text) so the UI renders real fields.","operationId":"actions_draft_api_actions_draft_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/actions/send":{"post":{"summary":"Actions Send","description":"P6: the APPROVAL GATE. Sends an explicitly reviewed draft through the\nconfigured transport. Unconfigured transports are a clean 503, and the\nsend is traced (who sent what, where).","operationId":"actions_send_api_actions_send_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/connectors/status":{"get":{"summary":"Connectors Status","description":"Which connector transports are configured — the UI renders honest\nstates instead of dead buttons. Vault rows win; legacy env tokens count\nas configured (dev/legacy path).","operationId":"connectors_status_api_connectors_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/connectors/slack/connect":{"get":{"summary":"Slack Connect","description":"Scope-picker entry: the dialog's choices become the Slack scope set.\nRedirects to Slack's consent screen; identity + choices bind into state.","operationId":"slack_connect_api_connectors_slack_connect_get","parameters":[{"name":"mode","in":"query","required":false,"schema":{"type":"string","default":"read_post","title":"Mode"}},{"name":"private","in":"query","required":false,"schema":{"type":"integer","default":0,"title":"Private"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/connectors/slack/workspaces":{"get":{"summary":"Slack Workspaces List","description":"Connected workspaces + granted access level — no tokens, ever.","operationId":"slack_workspaces_list_api_connectors_slack_workspaces_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/connectors/slack/{team_id}/channels":{"get":{"summary":"Slack Channels Route","description":"conversations.list — private channels appear only when the grant\nincluded groups:read (and only if the bot was invited).","operationId":"slack_channels_route_api_connectors_slack__team_id__channels_get","parameters":[{"name":"team_id","in":"path","required":true,"schema":{"type":"string","title":"Team Id"}},{"name":"types","in":"query","required":false,"schema":{"type":"string","default":"public_channel,private_channel","title":"Types"}},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","default":"","title":"Cursor"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/connectors/slack/{team_id}/messages":{"get":{"summary":"Slack Messages Route","description":"conversations.history with cursor pagination. DM/MPIM channels\nrequire the USER token (bot tokens cannot read them).","operationId":"slack_messages_route_api_connectors_slack__team_id__messages_get","parameters":[{"name":"team_id","in":"path","required":true,"schema":{"type":"string","title":"Team Id"}},{"name":"channel","in":"query","required":true,"schema":{"type":"string","title":"Channel"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":50,"title":"Limit"}},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","default":"","title":"Cursor"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/connectors/slack/{team_id}/post":{"post":{"summary":"Slack Post Route","description":"chat.postMessage — refused 403 unless the grant actually included\nchat:write. The read-only access level can never post.","operationId":"slack_post_route_api_connectors_slack__team_id__post_post","parameters":[{"name":"team_id","in":"path","required":true,"schema":{"type":"string","title":"Team Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/connectors/slack/{team_id}/disconnect":{"post":{"summary":"Slack Disconnect Route","description":"auth.revoke at Slack, then delete the stored workspace. The grant is\ngone from both sides after this.","operationId":"slack_disconnect_route_api_connectors_slack__team_id__disconnect_post","parameters":[{"name":"team_id","in":"path","required":true,"schema":{"type":"string","title":"Team Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/connectors/oauth/{provider}/start":{"get":{"summary":"Connectors Oauth Start","description":"302 the browser to the provider's consent screen. Identity is bound\nserver-side into `state` — the token that comes back can only ever land\non the identity that started the flow.","operationId":"connectors_oauth_start_api_connectors_oauth__provider__start_get","parameters":[{"name":"provider","in":"path","required":true,"schema":{"type":"string","title":"Provider"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/connectors/oauth/{provider}/callback":{"get":{"summary":"Connectors Oauth Callback","description":"Provider redirects here. Validates state, exchanges the code, stores\nthe encrypted grant, lands on /?connected=<provider> for the UI toast.","operationId":"connectors_oauth_callback_api_connectors_oauth__provider__callback_get","parameters":[{"name":"provider","in":"path","required":true,"schema":{"type":"string","title":"Provider"}},{"name":"code","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Code"}},{"name":"state","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"State"}},{"name":"error","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Error"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/connectors/disconnect":{"post":{"summary":"Connectors Disconnect","description":"Forget a grant (vault row deleted). Stops future syncs; already\nimported documents stay cited — disconnect is not un-ingest.","operationId":"connectors_disconnect_api_connectors_disconnect_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/connectors/import":{"post":{"summary":"Connectors Import","description":"P6 connector: pull EXTERNAL messages (Slack channel history, Gmail\ninbox) into a brain through the same ingest primitive as uploads —\nimported text becomes citable like any uploaded document. Env-gated:\nSLACK_BOT_TOKEN for Slack, GMAIL_USER/GMAIL_APP_PASSWORD for Gmail.","operationId":"connectors_import_api_connectors_import_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/ask":{"get":{"summary":"Ask","description":"Stream the answer as newline-delimited JSON so the UI never sits blank.\n\n`context` carries the preceding turns of the conversation. It is prepended\nto the question so a follow-up (\"and who signs it off?\") is resolved against\nwhat was already asked — without it, every turn is a cold start and a\nfollow-up question has no referent.","operationId":"ask_api_ask_get","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string","title":"Q"}},{"name":"dataset","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Dataset"}},{"name":"context","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Context"}},{"name":"tz","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Tz"}},{"name":"local_time","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Local Time"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/graph":{"get":{"summary":"Graph","description":"The knowledge graph, for the graph view.","operationId":"graph_api_graph_get","parameters":[{"name":"dataset","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Dataset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/stats":{"get":{"summary":"Stats","description":"Graph size — cheap numbers that make the graph feel real.\n\nUses /graph rather than /graph-summary: the summary endpoint returns\nnumNodes 0 until a summary run has been computed, which would render as\na confidently empty graph.","operationId":"stats_api_stats_get","parameters":[{"name":"dataset","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Dataset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/brains":{"get":{"summary":"List Brains","description":"Every brain on the tenant. Sizes are fetched per row by the dashboard.","operationId":"list_brains_api_brains_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"post":{"summary":"Create Brain","description":"Create a brain from uploaded documents, or add to an existing one.\n\n`append=False` (the default) refuses an existing name with 409: silently\nmerging into a brain the user believes is new would produce answers from\ndocuments they never saw. `append=True` is the explicit opt-in — the user\nhas been told the brain exists and chose to add to it.\n\nOrder matters: validate the name BEFORE touching the tenant, and never\nwrite to the demo dataset.","operationId":"create_brain_api_brains_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_create_brain_api_brains_post"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/brains/{name}/events":{"get":{"summary":"Brain Events","operationId":"brain_events_api_brains__name__events_get","parameters":[{"name":"name","in":"path","required":true,"schema":{"type":"string","title":"Name"}},{"name":"timeout_s","in":"query","required":false,"schema":{"type":"integer","default":600,"title":"Timeout S"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/brains/{name}":{"delete":{"summary":"Delete Brain","description":"Remove a brain.\n\nRESERVED_NAMES is enforced here as well as in create_brain. The UI hides the\ndelete button for the demo and system brains, but the API is the real\nboundary — and `DELETE /api/brains/default_dataset` would otherwise delete\nCognee's own internal dataset. The demo guard also lives inside\ncognee_cloud.delete_dataset, so neither layer can be bypassed on its own.","operationId":"delete_brain_api_brains__name__delete","parameters":[{"name":"name","in":"path","required":true,"schema":{"type":"string","title":"Name"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/source":{"get":{"summary":"Source","description":"Return the text of a cited source document, so a citation is checkable.\n\nA citation you cannot open is an assertion. This makes it verifiable.\n\nPath safety: only a bare filename is accepted - no separators, no parent\nreferences - and the resolved path is re-checked to be inside corpus/\nbefore it is read. `basename` alone is not enough on its own, so both\nchecks run.","operationId":"source_api_source_get","parameters":[{"name":"name","in":"query","required":true,"schema":{"type":"string","title":"Name"}},{"name":"dataset","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Dataset"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/":{"get":{"summary":"Index","operationId":"index__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/graph":{"get":{"summary":"Graph Page","operationId":"graph_page_graph_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/brains":{"get":{"summary":"Brains Page","operationId":"brains_page_brains_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/upload":{"get":{"summary":"Upload Page","operationId":"upload_page_upload_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"Body_create_brain_api_brains_post":{"properties":{"name":{"type":"string","title":"Name"},"files":{"items":{"type":"string","format":"binary"},"type":"array","title":"Files"},"append":{"type":"boolean","title":"Append","default":false}},"type":"object","required":["name","files"],"title":"Body_create_brain_api_brains_post"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}